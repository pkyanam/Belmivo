{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-imessage-relay-prototype",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "DeviceInbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceInbox"] }]
}
